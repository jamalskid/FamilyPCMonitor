<Window x:Class="FamilyPCMonitor.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Family PC Monitor" Height="720" Width="1040" MinHeight="580" MinWidth="800" Background="#F3F6F4">
 <DockPanel>
  <Border DockPanel.Dock="Top" Background="#174F39" Padding="18"><StackPanel><TextBlock Text="Family PC Monitor" Foreground="White" FontSize="24" FontWeight="Bold"/><TextBlock Text="Monitoring is visible and enabled for this Windows account" Foreground="#D9EEE3"/></StackPanel></Border>
  <TabControl Margin="14">
   <TabItem Header="Dashboard"><ScrollViewer><StackPanel Margin="16">
    <TextBlock Text="Monitoring status" FontSize="18" FontWeight="Bold"/><TextBlock x:Name="StatusText" FontSize="17" Margin="4,10"/>
    <TextBlock x:Name="DeviceText" Margin="4"/><TextBlock x:Name="UserText" Margin="4"/><TextBlock x:Name="LastEventText" Margin="4"/><TextBlock x:Name="DbText" Margin="4"/><TextBlock x:Name="DiscordStatusText" Margin="4"/>
    <Button Content="Refresh" Click="Refresh_Click" HorizontalAlignment="Left"/><TextBlock Margin="4,18" TextWrapping="Wrap" Text="This app records Windows startup and session state events on this computer. Its green notification-area icon remains visible while it is running. No keystrokes, browsing history, messages, passwords, camera, or microphone data are collected."/>
   </StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Event History"><DockPanel Margin="10"><StackPanel DockPanel.Dock="Top" Orientation="Horizontal"><TextBox x:Name="SearchBox" Width="260" ToolTip="Search event, user, or computer"/><Button Content="Search" Click="Search_Click"/><Button Content="Export CSV" Click="Export_Click"/></StackPanel><DataGrid x:Name="EventsGrid" IsReadOnly="True" AutoGenerateColumns="True" CanUserAddRows="False"/></DockPanel></TabItem>
   <TabItem Header="Discord"><ScrollViewer><StackPanel Margin="16" MaxWidth="750" HorizontalAlignment="Left"><TextBlock Text="Discord webhook" FontSize="18" FontWeight="Bold"/><TextBlock TextWrapping="Wrap" Margin="4" Text="Paste a channel webhook URL to enable event notifications. Saved URL is encrypted for this Windows account and is never displayed again."/><PasswordBox x:Name="WebhookBox" Margin="4" Padding="7"/><Button Content="Save webhook" Click="SaveWebhook_Click" HorizontalAlignment="Left"/><Button Content="Test Discord Notification" Click="TestDiscord_Click" HorizontalAlignment="Left"/><TextBlock Text="Send these event types" FontWeight="Bold" Margin="8,16,4,4"/><CheckBox x:Name="StartedCheck" Content="Computer started"/><CheckBox x:Name="LoginCheck" Content="User logged in"/><CheckBox x:Name="LockCheck" Content="Computer locked"/><CheckBox x:Name="UnlockCheck" Content="Computer unlocked"/><CheckBox x:Name="LogoutCheck" Content="User logged out"/><CheckBox x:Name="ShutdownCheck" Content="Computer shut down / restarted"/><Button Content="Save notification settings" Click="SaveSettings_Click" HorizontalAlignment="Left"/><TextBlock x:Name="WebhookStatus" Margin="6"/></StackPanel></ScrollViewer></TabItem>
   <TabItem Header="Monitoring &amp; Privacy"><StackPanel Margin="16" MaxWidth="760" HorizontalAlignment="Left"><TextBlock Text="Monitoring" FontSize="18" FontWeight="Bold"/><CheckBox x:Name="MonitoringCheck" Content="Monitoring enabled" Margin="5"/><CheckBox x:Name="StartupCheck" Content="Start with Windows (current user)" Margin="5"/><Button Content="Save monitoring settings" Click="SaveMonitoring_Click" HorizontalAlignment="Left"/><TextBlock Text="Log retention" FontWeight="Bold" Margin="6,16,4,4"/><ComboBox x:Name="RetentionBox" Width="220" HorizontalAlignment="Left"><ComboBoxItem Content="7 days" Tag="7"/><ComboBoxItem Content="30 days" Tag="30"/><ComboBoxItem Content="90 days" Tag="90"/><ComboBoxItem Content="Keep forever" Tag="0"/></ComboBox><Button Content="Save retention" Click="SaveRetention_Click" HorizontalAlignment="Left"/><TextBlock Text="Privacy" FontSize="18" FontWeight="Bold" Margin="4,18,4,4"/><TextBlock TextWrapping="Wrap" Text="Collected: event type, UTC and local event time, computer name, and current Windows account name. Stored locally in %LOCALAPPDATA%\FamilyPCMonitor\events.db. If configured, event type, computer name, account name, and local event time are sent to your Discord webhook. Logs are retained per the selected setting. The webhook secret is protected with Windows DPAPI for this user." Margin="4"/><Button Content="Delete all locally stored logs" Click="DeleteLogs_Click" HorizontalAlignment="Left"/></StackPanel></TabItem>
  </TabControl>
 </DockPanel>
</Window>
